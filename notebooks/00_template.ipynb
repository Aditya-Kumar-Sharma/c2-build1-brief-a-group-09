"# pd.read_csv(bad_path)"
]
},
{
"cell_type": "markdown",
"metadata": {},
"source": [
"## Output\n\n",
"Raw inventory scan complete. Inventory count matches expected raw structure."
]
},
{
"cell_type": "code",
"execution_count": null,
"metadata": {},
"outputs": [],
"source": [
"print('Verified raw file tree containing', len(df_files), 'files.')"
]
}
